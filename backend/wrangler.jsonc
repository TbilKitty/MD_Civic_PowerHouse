{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maryland-legislative-watch-subscriptions",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "vars": {
    "SITE_URL": "https://YOUR-USERNAME.github.io/YOUR-REPOSITORY",
    "SITE_ORIGIN": "https://YOUR-USERNAME.github.io",
    "WORKER_URL": "https://maryland-legislative-watch-subscriptions.YOUR-SUBDOMAIN.workers.dev",
    "EMAIL_FROM": "Maryland Legislative Watch <updates@YOUR-DOMAIN.example>"
  },
  "triggers": {
    "crons": ["0 13 * * *"]
  },
  "d1_databases": [
    {
      "binding": "SUBSCRIBERS",
      "database_name": "maryland-legislative-watch",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
